# =====================================================================
#  SETTINGS FOR YOUR WEBSITE
#  - Lines starting with # are notes. The computer ignores them.
#  - Write each setting as  NAME=value   (no spaces around the = sign)
#  - After changing anything here, stop the server and start it again.
# =====================================================================

# --- 1. ADMIN PASSWORD (required) ------------------------------------
# The password for http://localhost:3000/admin
# Make it at least 8 characters. Do NOT share it.
ADMIN_PASSWORD=change-me-please

# --- 2. BASICS (you can leave these alone) ---------------------------
PORT=3000
TIMEZONE=Asia/Kolkata
PRICE_RUPEES=10000
# how far ahead people can book, in days
DAYS_AHEAD_LIMIT=60

# --- 3. TELEGRAM ALERTS (optional, easiest way to get notified) -----
# See README.md, step "Get booking alerts on your phone".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 4. EMAIL ALERTS (optional) --------------------------------------
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your gmail address, SMTP_PASS=a Gmail "App Password"
# (NOT your normal Gmail password). See README.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# --- 5. PAYMENTS WITH RAZORPAY (optional, leave empty to switch off) -
# DEPOSIT_RUPEES is how much is charged when someone books (e.g. 1000).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEPOSIT_RUPEES=0

# --- 6. HOSTING (only when the site is online, e.g. on Render) ------
# Set to 1 when hosting online. Leave 0 on your own computer.
TRUST_PROXY=0

# Neon Postgres connection (Vercel provides this automatically)
DATABASE_URL=
