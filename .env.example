# =====================================================================
#  SETTINGS FOR YOUR WEBSITE
#  - Lines starting with # are notes. The computer ignores them.
#  - Write each setting as  NAME=value   (no spaces around the = sign)
#  - After changing anything here, stop the server and start it again.
# =====================================================================

# --- 1. ADMIN PASSWORD (required) ------------------------------------
# The password for http://localhost:3000/admin
# Make it at least 8 characters. Do NOT share it.
ADMIN_PASSWORD=change-me-please

# --- 2. BASICS (you can leave these alone) ---------------------------
PORT=3000
TIMEZONE=Asia/Kolkata
PRICE_RUPEES=10000
# how far ahead people can book, in days
DAYS_AHEAD_LIMIT=60

# --- 3. TELEGRAM ALERTS (optional, easiest way to get notified) -----
# See README.md, step "Get booking alerts on your phone".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 4. EMAIL & APPLICANT RECEIPTS (Gmail SMTP) ---------------------
# For Gmail SMTP:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (or 587)
# SMTP_USER=roojool.talekar@gmail.com
# SMTP_PASS=your 16-character Gmail App Password (requires 2FA enabled on Google Account)
# Note: NOTIFY_EMAIL receives booking alerts; applicant receipts are sent directly
# to applicant email addresses using SMTP_USER as the sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# --- 5. CLOUDFLARE R2 PRIVATE PHOTO STORAGE ------------------------
# Free tier allowance: 10 GB storage/month, 10M Class B (read) ops, 1M Class A (write) ops.
# Bucket must be kept private (no public bucket access needed).
# In Cloudflare dashboard: R2 -> Manage R2 API Tokens -> Create API Token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=presence-applications

# --- 6. STAGED UPLOADS CLEANUP CRON SECRET ---------------------------
# Bearer token for triggering POST /api/cron/cleanup manually.
CRON_SECRET=

# --- 7. PAYMENTS WITH RAZORPAY (optional, leave empty to switch off) -
# DEPOSIT_RUPEES is how much is charged when someone books (e.g. 1000).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEPOSIT_RUPEES=0

# --- 8. HOSTING (Cloudflare Workers / Render / Railway) -------------
# Set to 1 when hosting behind a reverse proxy. Leave 0 on your PC.
TRUST_PROXY=0

# Neon Postgres connection string
DATABASE_URL=
